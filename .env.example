# ============================================================================
# نموذج متغيرات البيئة - انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# لا ترفع ملف .env إلى المستودع أبداً
# ============================================================================

# قاعدة البيانات - Neon Postgres
# احصل عليها من: https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# المصادقة
# AUTH_SECRET: مفتاح عشوائي لتوقيع JWT (استخدم: openssl rand -base64 32)
AUTH_SECRET=""

# APP_PASSWORD: كلمة مرور الدخول للتطبيق
APP_PASSWORD=""

# MCP Server API Key
# مفتاح للوصول إلى /api/mcp من أدوات الذكاء الاصطناعي الخارجية
MCP_API_KEY=""
