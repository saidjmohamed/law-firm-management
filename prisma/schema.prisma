// ============================================================================
// مخطط Prisma - قاعدة بيانات مكتب المحامي
// PostgreSQL (Vercel Postgres / Neon)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// الموكلون
// ============================================================================
model Client {
  id         Int      @id @default(autoincrement())
  name       String   @default("")
  phone      String   @default("") @db.VarChar(40)
  phone2     String?  @default("") @db.VarChar(40)
  address    String?
  wilaya     Int?     @default(16)
  nationalId String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cases Case[]
  tasks Task[]

  @@index([name])
  @@index([phone])
}

// ============================================================================
// القضايا
// ============================================================================
model Case {
  id               Int       @id @default(autoincrement())
  caseNumber       String    @default("") @db.VarChar(120)
  subject          String    @default("")
  caseNature       String?
  litigationStage  String?
  origCaseNumber   String?
  customStage      String?
  status           String    @default("جارية")

  clientId         Int?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // الهيئة القضائية
  wilayaId         Int?      @default(16)
  judiciaryType    String?
  courtLevel       String?
  courtId          Int?
  chamber          String?   @default("")
  chamberNumber    Int?

  councilName      String?   @default("")
  courtName        String?   @default("")

  // المالية
  totalFees        Int?      @default(0)
  paidAmount       Int?      @default(0)

  // التواريخ (DateTime — كان String سابقاً)
  registrationDate DateTime?
  firstSessionDate DateTime?
  delibDate        DateTime?
  judgmentDate     DateTime?

  // معلومات إضافية
  barPhone         String?   @default("")
  lawyer           String?
  notes            String?
  judgment         String?
  caseResult       String?   // 'won' = ربحت القضية | 'lost' = خسرت القضية | null

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parties   Party[]
  delays    Delay[]
  sessions  Session[]
  payments  Payment[]
  archives  Archive[]
  tasks     Task[]

  @@index([caseNumber])
  @@index([status])
  @@index([delibDate])
  @@index([firstSessionDate])
  @@index([clientId])
}

// ============================================================================
// الأطراف
// ============================================================================
model Party {
  id          Int      @id @default(autoincrement())
  caseId      Int
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  role        String?
  side        String?  @default("for")   // 'for' = في حقه | 'against' = ضده
  name        String?  @default("")
  phone       String?  @default("")  @db.VarChar(40)
  lawyerName  String?
  lawyerPhone String?  @default("")  @db.VarChar(40)
  lawyerId    Int?
  lawyer      Lawyer?  @relation(fields: [lawyerId], references: [id], onDelete: SetNull)

  // الأتعاب الخاصة بهذا الطرف (فقط للأطراف "في حقه")
  totalFees   Int?     @default(0)
  paidAmount  Int?     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([caseId])
  @@index([name])
  @@index([phone])
}

// ============================================================================
// الآجال
// ============================================================================
model Delay {
  id        Int       @id @default(autoincrement())
  caseId    Int
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  delayDate DateTime?
  reason    String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([caseId])
  @@index([delayDate])
}

// ============================================================================
// الجلسات
// ============================================================================
model Session {
  id         Int       @id @default(autoincrement())
  caseId     Int?
  case       Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  caseNumber String?
  date       DateTime?
  time       String?
  court      String?
  chamber    String?
  roomNumber String?
  notes      String?
  status     String?   @default("scheduled")
  result     String?   @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([caseId])
  @@index([date])
  @@index([status])
}

// ============================================================================
// المدفوعات
// ============================================================================
model Payment {
  id         Int       @id @default(autoincrement())
  caseId     Int?
  case       Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  caseNumber String?
  amount     Int?      @default(0)
  type       String?   @default("income") // 'income' | 'expense'
  category   String?
  date       DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([caseId])
  @@index([date])
  @@index([type])
}

// ============================================================================
// الأرشيف
// ============================================================================
model Archive {
  id          Int      @id @default(autoincrement())
  caseId      Int
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseData    String   @default("") // JSON string - snapshot of case
  archiveDate DateTime?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([caseId])
}

// ============================================================================
// دفتر المحامين
// ============================================================================
model Lawyer {
  id             Int      @id @default(autoincrement())
  name           String   @default("")
  phone          String   @default("") @db.VarChar(40)
  phone2         String?  @default("") @db.VarChar(40)
  email          String?
  address        String?
  wilaya         Int?     @default(16)
  barNumber      String?  // رقم القيد في نقابة المحامين
  barAssociation String?
  specialty      String?
  source         String?  @default("manual")  // 'manual' | 'auto'
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // العلاقات - القضايا التي يترافع فيها هذا المحامي كطرف مقابل
  parties Party[]

  @@index([name])
  @@index([phone])
}

// ============================================================================
// الهيئات القضائية
// ============================================================================
model JudicialBody {
  id              Int      @id @default(autoincrement())
  name            String   @default("")
  type            String   @default("") // 'supreme' | 'council' | 'court' | 'admin_appeal' | 'admin_first' | 'commercial'
  wilayaId        Int?     @default(16)
  parentCouncilId Int?
  chambers        String?  @default("") // JSON string - array of {name, number}
  phones          String?  @default("") // JSON string - array of phone numbers
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([wilayaId])
}

// ============================================================================
// الإعدادات
// ============================================================================
model Setting {
  key   String @id
  value String @default("")
}

// ============================================================================
// الخيارات المخصصة
// ============================================================================
model CustomOption {
  id        Int      @id @default(autoincrement())
  field     String
  value     String
  label     String
  createdAt DateTime @default(now())

  @@unique([field, value])
  @@index([field])
}

// ============================================================================
// المهام والإجراءات القانونية
// ============================================================================
// تصميم قابل للتوسعة: يدعم حالياً المهام العادية + الإجراءات القانونية.
// مستقبلاً يمكن إضافة جدول LegalDeadlineRule منفصل يحتوي قواعد حساب الآجال
// (الاستئناف/المعارضة/الطعن بالنقض/التنفيذ) وربطها بـ task_type = 'legal_procedure'
// عبر حقل deadline_rule_id (مُعد مسبقاً كـ String? مرن).
// ============================================================================
model Task {
  id              Int       @id @default(autoincrement())

  // المحتوى الأساسي
  title           String    @default("")
  description     String?   @default("")
  taskType        String    @default("other")
  // قيم taskType:
  //   'session'        | 'memo'        | 'appeal'      | 'notification'
  //   | 'notice'        | 'execution'   | 'consultation'
  //   | 'legal_procedure' | 'other'
  // legal_procedure = إجراء قانوني بأجل نهائي محسوب

  priority        String    @default("medium")  // 'high' | 'medium' | 'low'
  status          String    @default("pending") // 'pending' | 'in_progress' | 'completed'

  // التواريخ الأساسية
  dueDate         DateTime?                          // تاريخ الاستحقاق (للمهام العادية)
  startDate       DateTime?                          // تاريخ بداية الإجراء القانوني
  legalDeadline   DateTime?                          // الأجل القانوني النهائي (للإجراءات القانونية)

  // التذكيرات — مهمة واحدة + offsets تُحسب ديناميكياً عند العرض
  // مثال: [7, 1, 0] = تذكير قبل 7 أيام + قبل يوم + يوم الاستحقاق
  reminderOffsets String?   @default("[]")           // JSON array of integers (days)

  // التكامل مع Smart Tasks
  sourceType      String?   @default("manual")       // 'manual' | 'session' | 'judgment' | 'delay'
  sourceId        Int?                                 // ID الجلسة/الحكم/التأجيل الأصلي

  // الربط بالقضايا والموكلين (اختياري)
  relatedCaseId   Int?
  relatedCase     Case?     @relation(fields: [relatedCaseId], references: [id], onDelete: SetNull)
  relatedClientId Int?
  relatedClient   Client?   @relation(fields: [relatedClientId], references: [id], onDelete: SetNull)

  // إضافة مستقبلية: ربط بقواعد الآجال القانونية
  // deadlineRuleId String?                              // مرجع لقاعدة آجال في جدول مستقبلي

  // حقول إدارية
  assignedTo      String?                             // اسم المسؤول (مستقبلاً: userId)
  notes           String?
  completedAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([relatedCaseId])
  @@index([relatedClientId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([legalDeadline])
  @@index([taskType])
  @@index([sourceType, sourceId])
}
