// ============================================================================
// مخطط Prisma - قاعدة بيانات مكتب المحامي
// PostgreSQL (Vercel Postgres / Neon)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// الموكلون
// ============================================================================
model Client {
  id         Int      @id @default(autoincrement())
  name       String   @default("")
  phone      String   @default("")
  phone2     String?  @default("")
  address    String?  @default("")
  wilaya     Int?     @default(16)
  nationalId String?  @default("")
  notes      String?  @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cases Case[]
}

// ============================================================================
// القضايا
// ============================================================================
model Case {
  id               Int      @id @default(autoincrement())
  caseNumber       String   @default("")
  subject          String   @default("")
  caseNature       String?  @default("")
  litigationStage  String?  @default("")
  origCaseNumber   String?  @default("")
  customStage      String?  @default("")
  status           String   @default("جارية")

  clientId         Int?
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // الهيئة القضائية
  wilayaId         Int?     @default(16)
  judiciaryType    String?  // 'supreme' | 'ordinary' | 'admin'
  courtLevel       String?  // 'council' | 'court' | 'admin_appeal' | 'admin_first' | 'commercial'
  courtId          Int?
  chamber          String?  @default("")
  chamberNumber    Int?

  councilName      String?  @default("")
  courtName        String?  @default("")

  // المالية
  totalFees        Int?     @default(0)
  paidAmount       Int?     @default(0)

  // التواريخ
  registrationDate String?  @default("")
  firstSessionDate String?  @default("")
  delibDate        String?  @default("")

  // معلومات إضافية
  barPhone         String?  @default("")
  lawyer           String?  @default("")
  notes            String?  @default("")
  judgment         String?  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parties   Party[]
  delays    Delay[]
  sessions  Session[]
  payments  Payment[]
  archives  Archive[]
}

// ============================================================================
// الأطراف
// ============================================================================
model Party {
  id          Int      @id @default(autoincrement())
  caseId      Int
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  role        String?  @default("")
  name        String?  @default("")
  phone       String?  @default("")
  lawyerName  String?  @default("")
  lawyerPhone String?  @default("")
  lawyerId    Int?     // ربط اختياري بجدول المحامين
  lawyer      Lawyer?  @relation(fields: [lawyerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================================
// الآجال
// ============================================================================
model Delay {
  id        Int      @id @default(autoincrement())
  caseId    Int
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  delayDate String?  @default("")
  reason    String?  @default("")
  notes     String?  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// الجلسات
// ============================================================================
model Session {
  id         Int      @id @default(autoincrement())
  caseId     Int?
  case       Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  caseNumber String?  @default("")
  date       String?  @default("")
  time       String?  @default("")
  court      String?  @default("")
  chamber    String?  @default("")
  roomNumber String?  @default("")
  notes      String?  @default("")
  status     String?  @default("scheduled")
  result     String?  @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================================
// المدفوعات
// ============================================================================
model Payment {
  id         Int      @id @default(autoincrement())
  caseId     Int?
  case       Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  caseNumber String?  @default("")
  amount     Int?     @default(0)
  type       String?  @default("income") // 'income' | 'expense'
  category   String?  @default("")
  date       String?  @default("")
  notes      String?  @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================================
// الأرشيف
// ============================================================================
model Archive {
  id         Int      @id @default(autoincrement())
  caseId     Int
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseData   String   @default("") // JSON string - snapshot of case
  archiveDate String  @default("")
  reason     String?  @default("")
  createdAt  DateTime @default(now())
}

// ============================================================================
// دفتر المحامين
// ============================================================================
model Lawyer {
  id          Int      @id @default(autoincrement())
  name        String   @default("")
  phone       String   @default("")
  phone2      String?  @default("")
  email       String?  @default("")
  address     String?  @default("")
  wilaya      Int?     @default(16)
  barNumber   String?  @default("")  // رقم القيد في نقابة المحامين
  specialty   String?  @default("")  // التخصص
  notes       String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // العلاقات - القضايا التي يترافع فيها هذا المحامي كطرف مقابل
  parties Party[]
}

// ============================================================================
// الهيئات القضائية
// ============================================================================
model JudicialBody {
  id              Int      @id @default(autoincrement())
  name            String   @default("")
  type            String   @default("") // 'supreme' | 'council' | 'court' | 'admin_appeal' | 'admin_first' | 'commercial'
  wilayaId        Int?     @default(16)
  parentCouncilId Int?
  chambers        String?  @default("") // JSON string - array of {name, number}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// الإعدادات
// ============================================================================
model Setting {
  key   String @id
  value String @default("")
}
